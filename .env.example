DATA_PATH=./data/orders.json
# Keep HOST=127.0.0.1. This demo has no authentication.
# 0.0.0.0 can expose every tool, including cancel_order, to your network.
# The Origin check is not authentication: requests with no Origin header pass.
# With mcp 2.3.0, Host and Origin checks turn on automatically only for 127.0.0.1, localhost or ::1.
HOST=127.0.0.1
PORT=8000
SERVER_URL=http://127.0.0.1:8000/mcp
